# =============================================================================
# DIFFUSIO — Configuration du serveur (fichier .env)
# =============================================================================
# Copie a placer dans /opt/diffusio/app/.env, puis : chmod 600 .env
# Remplacez chaque valeur <...>. Ne partagez jamais ce fichier.
# Apres modification : sudo systemctl restart diffusio
# (et npm run build avant, si une variable NEXT_PUBLIC_ a change)
# =============================================================================

# --- Base de donnees PostgreSQL ---------------------------------------------
# Sur un PostgreSQL installe sur le serveur, les deux valeurs sont IDENTIQUES.
DATABASE_URL="postgresql://diffusio:<MOT_DE_PASSE_BASE>@localhost:5432/diffusio"
DIRECT_URL="postgresql://diffusio:<MOT_DE_PASSE_BASE>@localhost:5432/diffusio"

# --- Authentification --------------------------------------------------------
# Secret : openssl rand -base64 33
AUTH_SECRET="<SECRET_1>"
# Adresse publique exacte du site, sans / final.
AUTH_URL="https://<VOTRE_DOMAINE>"

# --- Envois automatiques (rappels et relances) -------------------------------
# Secret : openssl rand -base64 33  (une valeur differente de AUTH_SECRET)
CRON_SECRET="<SECRET_2>"

# --- Compte administrateur initial -------------------------------------------
# Adresse du compte cree par « npx prisma db seed » (vide = super.admin@diffusio.local)
SEED_SUPER_ADMIN_EMAIL=""
# Indication grisee sur la page de connexion. LAISSER VIDE en production.
EMAIL_ADMIN_PAR_DEFAUT=""

# --- Stockage des fichiers deposes (Supabase Storage) ------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<PROJET>.supabase.co"
SUPABASE_SECRET_KEY="<sb_secret_...>"
SUPABASE_STORAGE_BUCKET="livrables"

# --- E-mails (Brevo) ---------------------------------------------------------
BREVO_API_KEY="<xkeysib-...>"
EMAIL_EXPEDITEUR="<adresse.verifiee@votre-institution.ci>"
EMAIL_EXPEDITEUR_NOM="DIFFUSIO"
# prod = envoi reel. Obligatoire hors Vercel, sinon les envois sont simules.
EMAIL_MODE="prod"
# Destinataire du message d'essai : npm run verifier:email -- --envoyer
EMAIL_TEST_DESTINATAIRE="<votre.adresse@votre-institution.ci>"

# --- Divers --------------------------------------------------------------------
# Taille maximale d'un fichier depose, en octets (20 Mo)
UPLOAD_TAILLE_MAX_OCTETS="20971520"
