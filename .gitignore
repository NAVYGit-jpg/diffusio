# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Le modele, lui, doit etre versionne : il ne contient aucune valeur reelle,
# seulement la liste des variables attendues et leur explication. Sans lui,
# un poste qui recupere le projet n'a aucun moyen de savoir quoi renseigner.
!.env.example

# Jeton de session des captures d'ecran (scripts/capturer-guide.mts).
# Il ouvre l'application au nom de la personne qui s'est connectee : il ne doit
# pas plus etre versionne qu'un mot de passe.
.playwright

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code (contient des cles d'API locales)
.claude/settings.local.json
