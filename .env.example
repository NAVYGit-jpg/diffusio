# =============================================================================
# DIFFUSIO — Variables d'environnement
# =============================================================================
# Copiez ce fichier en « .env » puis remplissez les valeurs.
# Le fichier « .env » n'est JAMAIS versionne dans Git (voir .gitignore).
# Ne partagez jamais son contenu par e-mail ou messagerie.
# =============================================================================

# --- Base de donnees PostgreSQL (Supabase) ---------------------------------
# Supabase > Project Settings > Database > Connection string > URI
# DATABASE_URL  : connexion applicative (via le pooler, port 6543)
# DIRECT_URL    : connexion directe (port 5432), utilisee par les migrations
DATABASE_URL="postgresql://user:motdepasse@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:motdepasse@host:5432/postgres"

# --- Authentification (Auth.js / NextAuth v5) ------------------------------
# Generer une valeur aleatoire avec : npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Compte administrateur initial ------------------------------------------
# Adresse du compte SUPER_ADMIN cree par « npx prisma db seed ».
# N'a d'effet que sur une base vide : le script ne modifie jamais un compte
# existant. Valeur par defaut si absente : super.admin@diffusio.local
SEED_SUPER_ADMIN_EMAIL=""
#
# Adresse affichee en gris dans le champ e-mail de la page de connexion, pour
# guider la toute premiere connexion. Ce n'est qu'une indication : le champ
# reste vide et rien n'est pre-rempli.
#
# EN PRODUCTION, LAISSER UNE CHAINE VIDE : cette ligne annonce a tout visiteur
# quelle adresse administre le site. Une chaine vide supprime l'indication.
EMAIL_ADMIN_PAR_DEFAUT=""

# --- Stockage des fichiers (Supabase Storage) ------------------------------
# Supabase > Settings > Data API      -> Project URL
NEXT_PUBLIC_SUPABASE_URL=""
#
# Supabase > Settings > API Keys      -> Secret key (commence par sb_secret_)
#
# ATTENTION : cette cle contourne toutes les regles de securite de la base.
# Elle ne doit JAMAIS apparaitre dans du code envoye au navigateur, ni etre
# versionnee, ni transiter par messagerie. Elle reste dans ce fichier .env,
# qui est exclu de Git.
SUPABASE_SECRET_KEY=""
#
# Nom du bucket prive contenant les livrables. A creer dans Supabase > Storage.
SUPABASE_STORAGE_BUCKET="livrables"

# --- E-mails transactionnels (Brevo) ---------------------------------------
BREVO_API_KEY=""
EMAIL_EXPEDITEUR="no-reply@example.org"
EMAIL_EXPEDITEUR_NOM="DIFFUSIO"

# EMAIL_MODE=test  -> tous les e-mails sont rediriges vers EMAIL_TEST_DESTINATAIRE
# EMAIL_MODE=prod  -> envoi reel aux destinataires
# En developpement, laissez IMPERATIVEMENT la valeur « test » (cahier des charges, §14).
EMAIL_MODE="test"
EMAIL_TEST_DESTINATAIRE="votre.adresse@example.org"

# --- Taches planifiees (GitHub Actions -> /api/cron/notifications) ---------
# Secret partage protegeant la route cron. Generer une longue chaine aleatoire.
CRON_SECRET=""

# --- Divers -----------------------------------------------------------------
# Taille maximale d'un fichier televerse, en octets (defaut : 20 Mo)
UPLOAD_TAILLE_MAX_OCTETS="20971520"
